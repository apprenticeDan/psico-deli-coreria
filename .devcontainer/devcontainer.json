{
    "name": "Fullstack: Java 21 / Spring Boot + TypeScript/SolidJS/Tailwind (Vite)",
    "dockerComposeFile": "../compose.yml",
    "service": "dev-env",
    "workspaceFolder": "/workspace",
    "shutdownAction": "stopCompose",
    // "updateRemoteUserUID": true,
    "remoteUser": "dev",
    "forwardPorts": [
        8088,
        5174,
        5430
    ],
    "mounts": [
        "source=gradle-cache,target=/home/dev/.gradle,type=volume"
    ],
    // "postStartCommand": "sudo chown -R dev:dev /workspace || true",
    "postCreateCommand": "bash -lc 'if [ -d frontend ]; then cd frontend && pnpm install; fi'",
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vmware.vscode-spring-boot",
                "vscjava.vscode-gradle",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "bradlc.vscode-tailwindcss"
            ]
        }
    }
}
