{
    "name": "Fullstack: Java 21 / Spring Boot + TypeScript/SolidJS/Tailwind (Vite)",
    "dockerComposeFile": "../compose.yml",
    "service": "dev-env",
    "workspaceFolder": "/workspace",
    "updateRemoteUserUID": true,
    "remoteUser": "dev",
    "forwardPorts": [
        8080,
        5173,
        5432
    ],
    "postStartCommand": "sudo chown -R dev:dev /workspace || true",
    "postCreateCommand": "bash -lc 'if [ -f backend/build.gradle ]; then cd backend && ./gradlew build -x test; fi; if [ -d frontend ]; then cd frontend && pnpm install; fi'",
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vmware.vscode-spring-boot",
                "vscjava.vscode-gradle",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "bradlc.vscode-tailwindcss"
            ]
        }
    }
}